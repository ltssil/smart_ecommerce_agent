# ============================================================
# LLM 模型配置
# ============================================================

# API Key
OPENAI_API_KEY=

# OpenAI 兼容接口地址
# 当前项目使用 SiliconFlow 提供的 DeepSeek 模型
OPENAI_BASE_URL=https://api.siliconflow.cn/v1

# 模型名称
OPENAI_MODEL=deepseek-ai/DeepSeek-V4-Flash


# ============================================================
# LangSmith 配置（可选，用于 Agent 调试与链路追踪）
# ============================================================

# 是否开启 LangSmith 追踪
LANGSMITH_TRACING=true

# LangSmith 服务地址
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# LangSmith API Key
LANGSMITH_API_KEY=

# LangSmith 项目名称
LANGSMITH_PROJECT=smart_ecommerce_agent


# ============================================================
# MySQL 数据库配置
# ============================================================

# MySQL 主机地址
MYSQL_HOST=127.0.0.1

# MySQL 端口
MYSQL_PORT=3306

# MySQL 用户名
MYSQL_USER=root

# MySQL 密码
MYSQL_PASSWORD=

# 项目数据库名称
MYSQL_DATABASE=smart_ecommerce_agent


# ============================================================
# BGE-M3 向量模型配置
# ============================================================

# BGE-M3 本地模型路径
# Windows 示例：
# D:/Models/bge-m3/models/bge-m3
MODEL_PATH=

# 模型运行设备
# CPU 环境填写 cpu
# 有 CUDA 环境时可以填写 cuda
MODEL_DEVICE=cpu


# ============================================================
# Milvus 向量数据库配置
# ============================================================

# Milvus 服务地址
MILVUS_URI=http://localhost:19530

# Milvus 数据库名称
MILVUS_DATABASE=default

# 售后政策向量集合名称
MILVUS_COLLECTION=after_sales_policies

# Milvus Token
# 本地无鉴权时保持为空
MILVUS_TOKEN=


# ============================================================
# Redis 配置
# ============================================================

# Redis 主机地址
REDIS_HOST=127.0.0.1

# Redis 端口
REDIS_PORT=6379

# Redis 数据库编号
REDIS_DB=0